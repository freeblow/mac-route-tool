<Window x:Class="SRM.App.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRM" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Margin="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.16" Color="#101828" />
        </Border.Effect>
        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock x:Name="IconText" Text="i" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="21" />
            <TextBlock x:Name="DetailText" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource HintText}" Visibility="Collapsed" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Dialog.Cancel}" MinWidth="86" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Dialog.Confirm}" MinWidth="86" Margin="10,0,0,0" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
