<Window x:Class="SRM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SRM.Core.Localization;assembly=SRM.Core"
        Title="{DynamicResource Ui.AppTitle}" Height="800" Width="1280" MinHeight="620" MinWidth="1020"
        Icon="SRM.ico"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18,16,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentBrush}">
                <TextBlock Text="SRM" Foreground="White" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.AppTitle}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{DynamicResource Ui.AppSubtitle}" Style="{StaticResource SubtitleText}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderInfoText" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Border Background="{StaticResource SegmentBrush}" CornerRadius="8" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangZhButton" Style="{StaticResource LangTab}" Content="中文" Tag="zh-Hans" Checked="Language_Checked" />
                        <RadioButton x:Name="LangEnButton" Style="{StaticResource LangTab}" Content="English" Tag="en" Checked="Language_Checked" />
                    </StackPanel>
                </Border>
                <Button x:Name="HeaderRefreshButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Refresh}" Click="RefreshAll_Click" />
            </StackPanel>
        </Grid>

        <!-- 标签 -->
        <Border Grid.Row="1" HorizontalAlignment="Left" Background="{StaticResource SegmentBrush}" CornerRadius="9" Padding="3">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabRoutes" Style="{StaticResource NavTab}" Content="{DynamicResource Ui.Tab.Routes}" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabNics" Style="{StaticResource NavTab}" Content="{DynamicResource Ui.Tab.Nics}" Checked="Tab_Checked" />
                <RadioButton x:Name="TabScan" Style="{StaticResource NavTab}" Content="{DynamicResource Ui.Tab.Scan}" Checked="Tab_Checked" />
            </StackPanel>
        </Border>

        <!-- 提示条 -->
        <Border x:Name="ElevationBanner" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource WarningSoftBrush}" BorderBrush="#F0DFC0" BorderThickness="1"
                CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
            <TextBlock x:Name="ElevationBannerText" Foreground="{StaticResource WarningBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Border x:Name="RouteCard" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="AddRouteButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Route.Add}" Click="AddRoute_Click" />
                                <Button x:Name="EditRouteButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Edit}" Margin="8,0,0,0" Click="EditRoute_Click" />
                                <Button x:Name="ToggleRouteButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Route.Toggle}" Margin="8,0,0,0" Click="ToggleRoute_Click" />
                                <Button x:Name="DeleteRouteButton" Style="{StaticResource DangerButton}" Content="{DynamicResource Ui.Delete}" Margin="8,0,0,0" Click="DeleteRoute_Click" />
                                <Border Style="{StaticResource ToolbarSeparator}" />
                                <Button x:Name="SyncRouteButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Route.Sync}" Click="SyncRoutes_Click" />
                                <Button x:Name="TestRouteButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Route.TestSelected}" Margin="8,0,0,0" Click="TestSelectedRoute_Click" />
                            </StackPanel>
                            <TextBlock x:Name="RouteSummaryText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="RouteGrid" Style="{StaticResource AppDataGrid}"
                                  ClipboardCopyMode="IncludeHeader"
                                  SelectionChanged="RouteGrid_SelectionChanged"
                                  MouseDoubleClick="RouteGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenu}">
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Route.CopyRow], Source={x:Static loc:Loc.Instance}}" Click="RouteCopyRow_Click" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Route.CopyDestination], Source={x:Static loc:Loc.Instance}}" Click="RouteCopyTarget_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{Binding [Ui.Col.Status], Source={x:Static loc:Loc.Instance}}" Width="104" ClipboardContentBinding="{Binding StateText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding StateBackground}" ToolTip="{Binding StateDetail}">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding [Ui.Col.Destination], Source={x:Static loc:Loc.Instance}}" Binding="{Binding DestinationText}" Width="180" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Gateway], Source={x:Static loc:Loc.Instance}}" Binding="{Binding GatewayText}" Width="140" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Interface], Source={x:Static loc:Loc.Instance}}" Binding="{Binding InterfaceText}" Width="180" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Note], Source={x:Static loc:Loc.Instance}}" Binding="{Binding NoteText}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Connectivity], Source={x:Static loc:Loc.Instance}}" Binding="{Binding TestText}" Width="290" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="" Width="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource Ui.Test}" Style="{StaticResource GridActionButton}" Click="TestRoute_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="RouteEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.Route.EmptyTitle}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Ui.Route.EmptyDetail}" Margin="0,8,0,0"
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="SystemRouteSection" Grid.Row="2" Visibility="Collapsed"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFBFD">
                        <Grid Margin="14,11,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Ui.SysRoute.SectionTitle}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="SystemRouteSummaryText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Style="{StaticResource SubtitleText}" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Margin="0,5,0,0" Style="{StaticResource HintText}"
                                       Text="{DynamicResource Ui.SysRoute.SectionHint}" />
                            <DataGrid x:Name="SystemRouteGrid" Grid.Row="2" Margin="0,9,0,0" MaxHeight="170"
                                      RowHeight="34" AlternatingRowBackground="Transparent"
                                      ClipboardCopyMode="IncludeHeader"
                                      PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown"
                                      Style="{StaticResource AppDataGrid}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource AppContextMenu}">
                                        <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.SysRoute.CopyRow], Source={x:Static loc:Loc.Instance}}" Click="SystemRouteCopyRow_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [Ui.Col.Destination], Source={x:Static loc:Loc.Instance}}" Binding="{Binding DestinationText}" Width="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{Binding [Ui.Col.Gateway], Source={x:Static loc:Loc.Instance}}" Binding="{Binding GatewayText}" Width="140" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{Binding [Ui.Col.Source], Source={x:Static loc:Loc.Instance}}" Binding="{Binding SourceText}" Width="258">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="Foreground" Value="{Binding SourceBrush}" />
                                                <Setter Property="ToolTip" Value="{Binding SourceText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{Binding [Ui.Col.Detail], Source={x:Static loc:Loc.Instance}}" Binding="{Binding DetailText}" Width="*" MinWidth="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="ToolTip" Value="{Binding DetailText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Button Content="{DynamicResource Ui.Delete}" Style="{StaticResource GridActionButton}" Padding="12,3"
                                                            Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left"
                                                            Visibility="{Binding DeleteVisibility}" Click="DeleteSystemRoute_Click" />
                                                    <TextBlock Text="{DynamicResource Ui.SysRoute.ChangeInAdapter}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                               Visibility="{Binding HintVisibility}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="NicCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="RaisePriorityButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Nic.Raise}" Click="RaisePriority_Click" />
                                    <Button x:Name="LowerPriorityButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.Lower}" Margin="8,0,0,0" Click="LowerPriority_Click" />
                                    <Button x:Name="AutoMetricButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.AutoMetric}" Margin="8,0,0,0" Click="AutoMetric_Click" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="DisableNicButton" Style="{StaticResource DangerButton}" Content="{DynamicResource Ui.Nic.Disable}" Click="DisableNic_Click" />
                                    <Button x:Name="EnableNicButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.Enable}" Margin="8,0,0,0" Click="EnableNic_Click" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="RefreshNicButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.RefreshList}" Click="RefreshAll_Click" />
                                </StackPanel>
                                <TextBlock x:Name="NicHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           Text="{DynamicResource Ui.Nic.Hint}" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="CoexistButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Nic.Coexist}" Click="Coexist_Click"
                                            ToolTip="{DynamicResource Ui.Nic.CoexistTip}" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="SetExitButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.SetExit}" Click="SetExit_Click"
                                            ToolTip="{DynamicResource Ui.Nic.SetExitTip}" />
                                    <Button x:Name="SetInternalButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.SetInternal}" Margin="8,0,0,0" Click="SetInternal_Click"
                                            ToolTip="{DynamicResource Ui.Nic.SetInternalTip}" />
                                    <Button x:Name="WeakHostButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.WeakHostOn}" Margin="8,0,0,0" Click="WeakHost_Click"
                                            ToolTip="{DynamicResource Ui.Nic.WeakHostTip}" />
                                </StackPanel>
                                <TextBlock x:Name="CoexistHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           Text="{DynamicResource Ui.Nic.CoexistHint}" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="FixDiscoverButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Nic.FixDiscovery}" Click="FixDiscover_Click"
                                            ToolTip="{DynamicResource Ui.Nic.FixDiscoveryTip}" />
                                    <Button x:Name="DiscoveryButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.Discovery}" Margin="8,0,0,0" Click="Discovery_Click"
                                            ToolTip="{DynamicResource Ui.Nic.DiscoveryTip}" />
                                    <Button x:Name="ListenDiscoverButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.Listen}" Margin="8,0,0,0" Click="ListenDiscover_Click"
                                            ToolTip="{DynamicResource Ui.Nic.ListenTip}" />
                                </StackPanel>
                                <TextBlock x:Name="DiscoveryHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{DynamicResource Ui.Nic.DiscoveryHint}" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="ShoutDiscoverButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.Shout}" Click="ShoutDiscover_Click"
                                            ToolTip="{DynamicResource Ui.Nic.ShoutTip}" />
                                    <Button x:Name="KeepShoutButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Nic.KeepShout}" Margin="8,0,0,0" Click="KeepShout_Click"
                                            ToolTip="{DynamicResource Ui.Nic.KeepShoutTip}" />
                                </StackPanel>
                                <TextBlock x:Name="ShoutHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{DynamicResource Ui.Nic.ShoutHint}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CoexistWarnBar" Grid.Row="1" Visibility="Collapsed"
                            Background="{StaticResource WarningSoftBrush}" BorderBrush="#F0DFC0" BorderThickness="0,0,0,1" Padding="14,9">
                        <TextBlock x:Name="CoexistWarnText" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="NicGrid" Style="{StaticResource AppDataGrid}"
                                  ClipboardCopyMode="IncludeHeader"
                                  SelectionChanged="NicGrid_SelectionChanged"
                                  PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenu}">
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Nic.CopyRow], Source={x:Static loc:Loc.Instance}}" Click="NicCopyRow_Click" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Nic.CopyAddress], Source={x:Static loc:Loc.Instance}}" Click="NicCopyAddress_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Ui.Col.Priority], Source={x:Static loc:Loc.Instance}}" Binding="{Binding RankText}" Width="64" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Nic], Source={x:Static loc:Loc.Instance}}" Binding="{Binding NameText}" Width="170" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Index], Source={x:Static loc:Loc.Instance}}" Binding="{Binding IndexText}" Width="62" />
                                <DataGridTemplateColumn Header="{Binding [Ui.Col.Status], Source={x:Static loc:Loc.Instance}}" Width="100" ClipboardContentBinding="{Binding StatusText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding [Ui.Col.Kind], Source={x:Static loc:Loc.Instance}}" Binding="{Binding KindText}" Width="66" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Speed], Source={x:Static loc:Loc.Instance}}" Binding="{Binding SpeedText}" Width="82" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Address], Source={x:Static loc:Loc.Instance}}" Binding="{Binding AddressText}" Width="150" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.DefaultGateway], Source={x:Static loc:Loc.Instance}}" Binding="{Binding GatewayText}" Width="140" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="{Binding [Ui.Col.Exit], Source={x:Static loc:Loc.Instance}}" Width="104" ClipboardContentBinding="{Binding ExitText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding ExitBackground}">
                                                <TextBlock Text="{Binding ExitText}" Foreground="{Binding ExitBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding [Ui.Col.Metric], Source={x:Static loc:Loc.Instance}}" Binding="{Binding MetricText}" Width="110" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="{Binding [Ui.Col.Coexist], Source={x:Static loc:Loc.Instance}}" Width="90" ClipboardContentBinding="{Binding WeakHostText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding WeakHostBackground}">
                                                <TextBlock Text="{Binding WeakHostText}" Foreground="{Binding WeakHostBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding [Ui.Col.Model], Source={x:Static loc:Loc.Instance}}" Binding="{Binding DescriptionText}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="NicEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.Nic.EmptyTitle}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="ScanCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Ui.Scan.Target}" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScanTargetPicker" Style="{StaticResource AppComboBox}" Width="230"
                                              SelectionChanged="ScanTargetPicker_SelectionChanged"
                                              ToolTip="{DynamicResource Ui.Scan.TargetPickerTip}" />
                                    <TextBox x:Name="ScanTargetText" Style="{StaticResource AppTextBox}" Width="250" Margin="8,0,0,0"
                                             ToolTip="{DynamicResource Ui.Scan.TargetTip}" />
                                    <Button x:Name="ScanStartButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Scan.Start}" Margin="8,0,0,0" Click="ScanStart_Click" />
                                    <Button x:Name="ScanStopButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Scan.Stop}" Margin="8,0,0,0" Click="ScanStop_Click" IsEnabled="False" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="ScanExportButton" Style="{StaticResource AppButton}" Content="{DynamicResource Ui.Scan.Export}" Click="ScanExport_Click" IsEnabled="False" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Ui.Scan.Show}" VerticalAlignment="Center" Style="{StaticResource SubtitleText}" Margin="0,0,8,0" />
                                    <ComboBox x:Name="ScanFilterCombo" Style="{StaticResource AppComboBox}" Width="140" SelectedIndex="0"
                                              SelectionChanged="ScanFilter_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Ui.Scan.Filter.All}" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Scan.Filter.Occupied}" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Scan.Filter.Free}" />
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="{DynamicResource Ui.Scan.Hint1}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}"
                                       Text="{DynamicResource Ui.Scan.Hint2}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <ProgressBar x:Name="ScanProgressBar" Height="6" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource SegmentBrush}"
                                         BorderThickness="0" />
                            <TextBlock x:Name="ScanSummaryText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"
                                       Text="{DynamicResource Ui.Scan.IdleSummary}" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="ScanGrid" Style="{StaticResource AppDataGrid}"
                                  ClipboardCopyMode="IncludeHeader"
                                  SelectionMode="Extended"
                                  MouseDoubleClick="ScanGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenu}">
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Scan.CopyAddress], Source={x:Static loc:Loc.Instance}}" Click="ScanCopyAddress_Click" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Scan.CopyRow], Source={x:Static loc:Loc.Instance}}" Click="ScanCopyRow_Click" />
                                    <Separator Style="{StaticResource AppMenuSeparator}" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding [Ui.Scan.CopyAll], Source={x:Static loc:Loc.Instance}}" Click="ScanCopyAll_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Ui.Scan.ColAddress], Source={x:Static loc:Loc.Instance}}" Binding="{Binding AddressText}" Width="150" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="{Binding [Ui.Col.Status], Source={x:Static loc:Loc.Instance}}" Width="120" ClipboardContentBinding="{Binding StateText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding StateBackground}">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding [Ui.Scan.ColMac], Source={x:Static loc:Loc.Instance}}" Binding="{Binding MacText}" Width="160" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Scan.ColRtt], Source={x:Static loc:Loc.Instance}}" Binding="{Binding RttText}" Width="96" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{Binding [Ui.Col.Detail], Source={x:Static loc:Loc.Instance}}" Binding="{Binding NoteText}" Width="*" MinWidth="220" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="ScanEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ScanEmptyTitle" Text="{DynamicResource Ui.Scan.EmptyTitle}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ScanEmptyDetail" Text="{DynamicResource Ui.Scan.EmptyDetail}" Margin="0,8,0,0"
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="4" Margin="2,12,2,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleText}" Text="{DynamicResource Ui.Status.Ready}" />
            <TextBlock x:Name="EnvText" Style="{StaticResource SubtitleText}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
