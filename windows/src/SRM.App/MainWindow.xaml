<Window x:Class="SRM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRM 网络助手" Height="800" Width="1280" MinHeight="620" MinWidth="1020"
        Icon="SRM.ico"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18,16,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentBrush}">
                <TextBlock Text="SRM" Foreground="White" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SRM 网络助手" Style="{StaticResource TitleText}" />
                <TextBlock Text="静态路由 · 网卡优先级 · 多网卡共存 · 网卡启停 · 网段检测" Style="{StaticResource SubtitleText}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderInfoText" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="HeaderRefreshButton" Style="{StaticResource AppButton}" Content="刷新" Click="RefreshAll_Click" />
            </StackPanel>
        </Grid>

        <!-- 标签 -->
        <Border Grid.Row="1" HorizontalAlignment="Left" Background="{StaticResource SegmentBrush}" CornerRadius="9" Padding="3">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabRoutes" Style="{StaticResource NavTab}" Content="静态路由" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabNics" Style="{StaticResource NavTab}" Content="网卡优先级" Checked="Tab_Checked" />
                <RadioButton x:Name="TabScan" Style="{StaticResource NavTab}" Content="IP 检测" Checked="Tab_Checked" />
            </StackPanel>
        </Border>

        <!-- 提示条 -->
        <Border x:Name="ElevationBanner" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource WarningSoftBrush}" BorderBrush="#F0DFC0" BorderThickness="1"
                CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
            <TextBlock x:Name="ElevationBannerText" Foreground="{StaticResource WarningBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Border x:Name="RouteCard" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="AddRouteButton" Style="{StaticResource PrimaryButton}" Content="+ 添加路由" Click="AddRoute_Click" />
                                <Button x:Name="EditRouteButton" Style="{StaticResource AppButton}" Content="编辑" Margin="8,0,0,0" Click="EditRoute_Click" />
                                <Button x:Name="ToggleRouteButton" Style="{StaticResource AppButton}" Content="启用 / 停用" Margin="8,0,0,0" Click="ToggleRoute_Click" />
                                <Button x:Name="DeleteRouteButton" Style="{StaticResource DangerButton}" Content="删除" Margin="8,0,0,0" Click="DeleteRoute_Click" />
                                <Border Style="{StaticResource ToolbarSeparator}" />
                                <Button x:Name="SyncRouteButton" Style="{StaticResource AppButton}" Content="重新同步" Click="SyncRoutes_Click" />
                                <Button x:Name="TestRouteButton" Style="{StaticResource AppButton}" Content="测试连通性" Margin="8,0,0,0" Click="TestSelectedRoute_Click" />
                            </StackPanel>
                            <TextBlock x:Name="RouteSummaryText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="RouteGrid" Style="{StaticResource AppDataGrid}"
                                  ClipboardCopyMode="IncludeHeader"
                                  SelectionChanged="RouteGrid_SelectionChanged"
                                  MouseDoubleClick="RouteGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenu}">
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制这条路由" Click="RouteCopyRow_Click" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制目标网段" Click="RouteCopyTarget_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="状态" Width="92" ClipboardContentBinding="{Binding StateText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding StateBackground}" ToolTip="{Binding StateDetail}">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="目标网段" Binding="{Binding DestinationText}" Width="180" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="网关" Binding="{Binding GatewayText}" Width="150" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="出口接口" Binding="{Binding InterfaceText}" Width="170" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding NoteText}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="连通性" Binding="{Binding TestText}" Width="300" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="测试" Style="{StaticResource GridActionButton}" Click="TestRoute_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="RouteEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="还没有配置静态路由" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="点左上角的「+ 添加路由」，把常用网段固定到这台机器上。" Margin="0,8,0,0"
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="SystemRouteSection" Grid.Row="2" Visibility="Collapsed"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFBFD">
                        <Grid Margin="14,11,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="系统里其它路由（不归 SRM 管）"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="SystemRouteSummaryText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Style="{StaticResource SubtitleText}" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Margin="0,5,0,0" Style="{StaticResource HintText}"
                                       Text="系统里已经存在、但不在 SRM 配置里的持久路由和网卡静态网关都列在这里（停用网卡留下的旧配置也算）。能删的点右侧「删除」；写着“网卡属性里改”的要到「网络连接」里改这块网卡。" />
                            <DataGrid x:Name="SystemRouteGrid" Grid.Row="2" Margin="0,9,0,0" MaxHeight="170"
                                      RowHeight="34" AlternatingRowBackground="Transparent"
                                      ClipboardCopyMode="IncludeHeader"
                                      PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown"
                                      Style="{StaticResource AppDataGrid}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource AppContextMenu}">
                                        <MenuItem Style="{StaticResource AppMenuItem}" Header="复制这一行" Click="SystemRouteCopyRow_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="目标网段" Binding="{Binding DestinationText}" Width="160" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="网关" Binding="{Binding GatewayText}" Width="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="258">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="Foreground" Value="{Binding SourceBrush}" />
                                                <Setter Property="ToolTip" Value="{Binding SourceText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="说明" Binding="{Binding DetailText}" Width="*" MinWidth="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="ToolTip" Value="{Binding DetailText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Button Content="删除" Style="{StaticResource GridActionButton}" Padding="12,3"
                                                            Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left"
                                                            Visibility="{Binding DeleteVisibility}" Click="DeleteSystemRoute_Click" />
                                                    <TextBlock Text="网卡属性里改" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                               Visibility="{Binding HintVisibility}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="NicCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="RaisePriorityButton" Style="{StaticResource PrimaryButton}" Content="↑ 提高优先级" Click="RaisePriority_Click" />
                                    <Button x:Name="LowerPriorityButton" Style="{StaticResource AppButton}" Content="↓ 降低优先级" Margin="8,0,0,0" Click="LowerPriority_Click" />
                                    <Button x:Name="AutoMetricButton" Style="{StaticResource AppButton}" Content="恢复自动跃点" Margin="8,0,0,0" Click="AutoMetric_Click" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="DisableNicButton" Style="{StaticResource DangerButton}" Content="禁用网卡" Click="DisableNic_Click" />
                                    <Button x:Name="EnableNicButton" Style="{StaticResource AppButton}" Content="启用网卡" Margin="8,0,0,0" Click="EnableNic_Click" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="RefreshNicButton" Style="{StaticResource AppButton}" Content="刷新列表" Click="RefreshAll_Click" />
                                </StackPanel>
                                <TextBlock x:Name="NicHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           Text="跃点数越小，网卡优先级越高 · 表格里右键可以复制" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="CoexistButton" Style="{StaticResource PrimaryButton}" Content="一键共存" Click="Coexist_Click"
                                            ToolTip="只保留一块网卡当上网出口，其余带网关的网卡改成仅内网，并让在用网卡允许跨网卡收发" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="SetExitButton" Style="{StaticResource AppButton}" Content="设为上网出口" Click="SetExit_Click"
                                            ToolTip="让选中的网卡负责上网，其它抢默认路由的网卡自动改成仅内网" />
                                    <Button x:Name="SetInternalButton" Style="{StaticResource AppButton}" Content="设为仅内网" Margin="8,0,0,0" Click="SetInternal_Click"
                                            ToolTip="选中的网卡不再抢上网出口，但仍然可以访问自己网段里的设备和服务器" />
                                    <Button x:Name="WeakHostButton" Style="{StaticResource AppButton}" Content="允许跨网卡收发" Margin="8,0,0,0" Click="WeakHost_Click"
                                            ToolTip="打开弱主机模式：这块网卡可以收发本机其它网卡的流量，多网卡同时工作时不至于互相丢包" />
                                </StackPanel>
                                <TextBlock x:Name="CoexistHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           Text="上网出口只留一块网卡；「共存」列表示是否允许跨网卡收发" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="FixDiscoverButton" Style="{StaticResource PrimaryButton}" Content="让局域网能发现这台机器" Click="FixDiscover_Click"
                                            ToolTip="一步修好“别人搜不到我”：停掉挡住发现包的「阻止」入站规则、把发现端口 53317 放行到所有网络位置、把这块网卡所在的网络位置改成「专用」，并让发现“喊话”从这块网卡出去；每一步都会实测并弹窗告诉你结果" />
                                    <Button x:Name="DiscoveryButton" Style="{StaticResource AppButton}" Content="让局域网发现走这块网卡" Margin="8,0,0,0" Click="Discovery_Click"
                                            ToolTip="只给 LocalSend 这类工具用的组播地址（224.0.0.167）加一条只走选中网卡的路由，让它们能“喊到”这台机器；不影响上网和普通访问，再点一次可以取消" />
                                    <Button x:Name="ListenDiscoverButton" Style="{StaticResource AppButton}" Content="听听看（诊断）" Margin="8,0,0,0" Click="ListenDiscover_Click"
                                            ToolTip="在发现端口上听 10 秒：列出谁在喊话，以及本机自己的喊话是从哪个地址发出去的；只读，不改系统，也不动别人的数据" />
                                </StackPanel>
                                <TextBlock x:Name="DiscoveryHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="局域网里搜不到这台机器时用（LocalSend、投屏等靠“喊话”发现的功能）" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="ShoutDiscoverButton" Style="{StaticResource AppButton}" Content="喊一声（让对面立刻看到）" Click="ShoutDiscover_Click"
                                            ToolTip="按发现软件的协议，用这台机器上 LocalSend 自己的设备名和证书指纹，从选中网卡发一条“我在这里”；发送直接绑在这块网卡上，不受“系统挑哪块网卡”影响。只发几条组播消息，不改系统设置" />
                                    <Button x:Name="KeepShoutButton" Style="{StaticResource AppButton}" Content="一直喊（每 15 秒一次）" Margin="8,0,0,0" Click="KeepShout_Click"
                                            ToolTip="每 15 秒自动替你喊一次，对方列表里就能一直有这台机器；再点一下停止。程序关掉就停，不改任何系统设置" />
                                </StackPanel>
                                <TextBlock x:Name="ShoutHintText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SubtitleText}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="想让对面现在就搜到，用它；不靠系统挑网卡" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CoexistWarnBar" Grid.Row="1" Visibility="Collapsed"
                            Background="{StaticResource WarningSoftBrush}" BorderBrush="#F0DFC0" BorderThickness="0,0,0,1" Padding="14,9">
                        <TextBlock x:Name="CoexistWarnText" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="NicGrid" Style="{StaticResource AppDataGrid}"
                                  ClipboardCopyMode="IncludeHeader"
                                  SelectionChanged="NicGrid_SelectionChanged"
                                  PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenu}">
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制这块网卡的信息" Click="NicCopyRow_Click" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制 IPv4 地址" Click="NicCopyAddress_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="优先级" Binding="{Binding RankText}" Width="58" />
                                <DataGridTextColumn Header="网卡" Binding="{Binding NameText}" Width="180" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="序号" Binding="{Binding IndexText}" Width="52" />
                                <DataGridTemplateColumn Header="状态" Width="86" ClipboardContentBinding="{Binding StatusText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="54" />
                                <DataGridTextColumn Header="速率" Binding="{Binding SpeedText}" Width="82" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="IPv4 地址" Binding="{Binding AddressText}" Width="140" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="默认网关" Binding="{Binding GatewayText}" Width="130" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="上网出口" Width="96" ClipboardContentBinding="{Binding ExitText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding ExitBackground}">
                                                <TextBlock Text="{Binding ExitText}" Foreground="{Binding ExitBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="跃点数" Binding="{Binding MetricText}" Width="100" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="共存" Width="84" ClipboardContentBinding="{Binding WeakHostText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding WeakHostBackground}">
                                                <TextBlock Text="{Binding WeakHostText}" Foreground="{Binding WeakHostBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="型号" Binding="{Binding DescriptionText}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="NicEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="没有读取到可管理的网卡" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="ScanCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock Text="网段或地址" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScanTargetPicker" Style="{StaticResource AppComboBox}" Width="230"
                                              SelectionChanged="ScanTargetPicker_SelectionChanged"
                                              ToolTip="本机各网卡的网段，选一个就填到右边" />
                                    <TextBox x:Name="ScanTargetText" Style="{StaticResource AppTextBox}" Width="250" Margin="8,0,0,0"
                                             ToolTip="支持三种写法：192.168.15.0/24（整个网段）、192.168.15.66（单个地址）、192.168.15.1-200（一段地址）" />
                                    <Button x:Name="ScanStartButton" Style="{StaticResource PrimaryButton}" Content="开始检测" Margin="8,0,0,0" Click="ScanStart_Click" />
                                    <Button x:Name="ScanStopButton" Style="{StaticResource AppButton}" Content="停止" Margin="8,0,0,0" Click="ScanStop_Click" IsEnabled="False" />
                                    <Border Style="{StaticResource ToolbarSeparator}" />
                                    <Button x:Name="ScanExportButton" Style="{StaticResource AppButton}" Content="导出 CSV" Click="ScanExport_Click" IsEnabled="False" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="显示" VerticalAlignment="Center" Style="{StaticResource SubtitleText}" Margin="0,0,8,0" />
                                    <ComboBox x:Name="ScanFilterCombo" Style="{StaticResource AppComboBox}" Width="140" SelectedIndex="0"
                                              SelectionChanged="ScanFilter_SelectionChanged">
                                        <ComboBoxItem Content="全部" />
                                        <ComboBoxItem Content="只看已占用" />
                                        <ComboBoxItem Content="只看空闲" />
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="同一个网段的设备用 ARP 探测：有回应就是已被占用（哪怕它不响应 Ping 也查得出来），两轮都没回应的就是空闲可用。" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}"
                                       Text="要复制地址：右键任意一行 →「复制地址」只拷 IP；「复制整行」按 Tab 分列，可直接粘进 Excel；双击一行也是复制地址，选中后 Ctrl+C 也行。" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <ProgressBar x:Name="ScanProgressBar" Height="6" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource SegmentBrush}"
                                         BorderThickness="0" />
                            <TextBlock x:Name="ScanSummaryText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"
                                       Text="填好网段（或从左边选一块网卡的网段），点「开始检测」。" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="ScanGrid" Style="{StaticResource AppDataGrid}"
                                  ClipboardCopyMode="IncludeHeader"
                                  SelectionMode="Extended"
                                  MouseDoubleClick="ScanGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="GridMenu_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenu}">
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制地址" Click="ScanCopyAddress_Click" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制整行" Click="ScanCopyRow_Click" />
                                    <Separator Style="{StaticResource AppMenuSeparator}" />
                                    <MenuItem Style="{StaticResource AppMenuItem}" Header="复制当前列表的全部行" Click="ScanCopyAll_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="150" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="状态" Width="110" ClipboardContentBinding="{Binding StateText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{Binding StateBackground}">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="MAC 地址" Binding="{Binding MacText}" Width="160" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="响应" Binding="{Binding RttText}" Width="90" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="说明" Binding="{Binding NoteText}" Width="*" MinWidth="220" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="ScanEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ScanEmptyTitle" Text="还没有检测结果" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ScanEmptyDetail" Text="填好网段或单个地址，点左上角的「开始检测」" Margin="0,8,0,0"
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="4" Margin="2,12,2,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleText}" Text="就绪" />
            <TextBlock x:Name="EnvText" Style="{StaticResource SubtitleText}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
